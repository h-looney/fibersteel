---
/**
 * What shows in place of a part of the site that's switched off (src/data/features.ts), for anyone who follows an old
 * link to it. Hidden while the part is on.
 */
import '../styles/installs.css';
import Icon from './Icon.astro';
import { featureLabels, type FeatureId } from '../data/features';
import { site, tel, prettyPhone } from '../data/site';
import { withBase } from '../scripts/url';

interface Props {
  feature: FeatureId;
  /** Shown as the heading level of the notice */
  headingLevel?: 'h1' | 'h2' | 'h3';
  /** A whole page or a section of one */
  page?: boolean;
}

const { feature, headingLevel: H = 'h2', page = false } = Astro.props;
const name = featureLabels[feature];
---

<div class="feature-off" data-feature-off={feature}>
  <Icon name="info" size={22} />
  <div>
    <H class="feature-off__title">{page ? `“${name}” isn’t on the site right now` : `“${name}” isn’t shown right now`}</H>
    <p>
      See <a href={withBase('/lifts/')}>our lifts by boat type</a>, or call us at
      <a href={tel(site.sales.phone)}>{prettyPhone(site.sales.phone)}</a> and we’ll gladly help.
    </p>
  </div>
</div>
