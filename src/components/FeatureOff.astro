---
/**
 * What shows in place of a part of the site switched off in FiberSteel mode — in this browser only (src/data/features.ts).
 * Hidden while the part is on. In production a switched-off part isn't published, so visitors wouldn't see this.
 */
import '../styles/installs.css';
import Icon from './Icon.astro';
import { featureLabels, type FeatureId } from '../data/features';
import { withBase } from '../scripts/url';

interface Props {
  feature: FeatureId;
  /** Shown as the heading level of the notice */
  headingLevel?: 'h1' | 'h2' | 'h3';
  /** A whole page (it wouldn't exist) or a section of one */
  page?: boolean;
}

const { feature, headingLevel: H = 'h2', page = false } = Astro.props;
const name = featureLabels[feature];
---

<div class="feature-off" data-feature-off={feature}>
  <Icon name="info" size={22} />
  <div>
    <H class="feature-off__title">“{name}” is switched off</H>
    <p>
      {
        page
          ? `FiberSteel mode has “${name}” turned off, so on the live site this page wouldn’t be published.`
          : `FiberSteel mode has “${name}” turned off, so this part of the page is hidden.`
      }{' '}
      Switch it back on in FiberSteel mode under <a href={withBase(`/office/website/?tab=installs&signin`)}>Website → Installs</a>. (This demo keeps the switch
      in your browser.)
    </p>
  </div>
</div>
