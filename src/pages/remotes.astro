---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import BrandPlaceholder from '../components/BrandPlaceholder.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { admiral, usd } from '../data/products';
import { remoteWarranty } from '../data/warranty';
import { photo, photos } from '../data/photos';
import { sources } from '../data/sources';
import { site, tel, prettyPhone } from '../data/site';
import { withBase } from '../scripts/url';

const hero = photo('performance/2-valve-admiral-14000');
---

<BaseLayout
  title="Remote Control Blower Systems — Admiral"
  description="Admiral remote control blower systems from FiberSteel: 1-, 2-, 3- and 4-valve systems and an A/B split for 2 lifts, with key fobs and a leak protection sensor — installed on the Lake of the Ozarks."
>
  <PageHero
    title="Remote controls"
    titleHtml="Raise your lift <em>from the boat</em>"
    eyebrow="Remote control blower systems"
    lead="FiberSteel sells and installs Admiral remote control blower systems — models to fit any size boat lift and any brand of boat lift."
    crumbs={[{ label: 'Owners', href: withBase('/owners/') }, { label: 'Remote controls' }]}
    image={hero}
  >
    <a href={withBase('/quote/?type=remote')} class="btn btn--sun">Ask about a remote <Icon name="arrow-right" size={18} class="icon-arrow" /></a>
    <a href={tel(site.sales.phone)} class="btn btn--ghost-light"><Icon name="phone" size={18} /> {prettyPhone(site.sales.phone)}</a>
  </PageHero>

  <section class="section">
    <div class="container remotes">
      <div class="remotes__copy">
        <SectionHeading eyebrow="Admiral remote control systems" title="Built with the features <em>you want</em>" />
        <ul class="checklist">
          {
            admiral.features.map((f) => (
              <li>
                <Icon name="check" size={18} strokeWidth={2.4} /> <span>{f.text}</span>
              </li>
            ))
          }
        </ul>
        <p class="remotes__aplus">
          <Icon name="remote" size={20} />
          <span><strong>Admiral A+:</strong> {admiral.aPlus.text.replace('The Admiral A+, ', '')}.</span>
        </p>
      </div>
      <div class="remotes__prices">
        <h2 class="h3">Prices</h2>
        <table class="price-table">
          <caption class="visually-hidden">Admiral remote control blower system prices</caption>
          <tbody>
            {
              admiral.prices.map((p) => (
                <tr>
                  <th scope="row">{p.label}</th>
                  <td>{usd(p.price)}</td>
                </tr>
              ))
            }
            <tr class="price-table__extra">
              <th scope="row">{admiral.install.label}</th>
              <td>{usd(admiral.install.price)}</td>
            </tr>
          </tbody>
        </table>
        <p class="small muted">
          As listed on FiberSteel’s <a class="text-link" href={sources[admiral.pricesSrc].url} target="_blank" rel="noopener">current remotes page</a>. Call to confirm current pricing.
        </p>
        <a href={tel(site.sales.phone)} class="btn btn--primary"><Icon name="phone" size={18} /> Call to order · {prettyPhone(site.sales.phone)}</a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <SectionHeading eyebrow="How many valves?" title="Matched to the lift" lead="From FiberSteel’s photos of lifts it fitted with Admiral systems:" />
      <ul class="valves" role="list">
        {
          admiral.valveNotes.map((v) => (
            <li>
              <Icon name="check" size={18} strokeWidth={2.4} /> {v.text}
            </li>
          ))
        }
      </ul>
      <PhotoGrid photos={photos(admiral.photos)} id="remote-photos" columns={4} />
    </div>
  </section>

  <section class="section">
    <div class="container remotes-ph">
      <BrandPlaceholder label="Admiral A+ remote and app" icon="remote" ratio="16 / 10" />
      <div class="stack">
        <h2 class="h3">Already have another brand’s remote?</h2>
        <p class="muted">Some remote systems’ warranties are handled by their makers:</p>
        <ul class="warranty-contacts" role="list">
          {
            remoteWarranty.map((r) => (
              <li>
                <strong>{r.system}</strong>
                <span>{r.who} — <a href={tel(r.phone)}>{prettyPhone(r.phone)}</a></span>
              </li>
            ))
          }
        </ul>
        <p class="muted small">For anything else, call FiberSteel’s service department at <a class="text-link" href={tel(site.service.phone)}>{prettyPhone(site.service.phone)}</a>.</p>
      </div>
    </div>
  </section>

  <CtaBand quoteHref={withBase('/quote/?type=remote')} image="remotes/1-controller-2-lifts" />
</BaseLayout>

<style>
  .remotes {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 960px) {
    .remotes {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }

  .remotes__copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .remotes__copy :global(.section-head) {
    margin-bottom: 0;
  }

  .remotes__aplus {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--c-accent-50);
  }

  .remotes__aplus :global(svg) {
    flex: none;
    color: var(--c-accent);
  }

  .remotes__prices {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow);
  }

  .price-table {
    width: 100%;
    border-collapse: collapse;
  }

  .price-table th,
  .price-table td {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--c-line);
    text-align: left;
  }

  .price-table td {
    text-align: right;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 780;
    font-size: var(--fs-lg);
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
  }

  .price-table th {
    font-weight: 600;
  }

  .price-table__extra th,
  .price-table__extra td {
    color: var(--c-text-muted);
    font-size: var(--fs-sm);
  }

  .valves {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding: 0;
    font-weight: 600;
  }

  .valves li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .valves :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--c-accent);
  }

  .remotes-ph {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .remotes-ph {
      grid-template-columns: 1fr 1fr;
    }
  }

  .warranty-contacts {
    display: grid;
    gap: var(--space-3);
    padding: 0;
  }

  .warranty-contacts li {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
  }

  .warranty-contacts a {
    color: var(--c-accent);
    font-weight: 600;
  }
</style>
