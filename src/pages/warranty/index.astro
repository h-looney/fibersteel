---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { coverage, keyPoints, terms, remoteWarranty, cancellation } from '../../data/warranty';
import { photo } from '../../data/photos';
import { sources } from '../../data/sources';
import { site, tel, prettyPhone } from '../../data/site';
import { withBase } from '../../scripts/url';

const hero = photo('shallow/8000-shallow-2');
---

<BaseLayout
  title="Boat Lift Warranty"
  description="FiberSteel's warranty: lifetime on the polyethylene tanks and lift frame, 5 years on hot-dipped galvanized parts, 3 years on the blower controller, bushings and hose — for lifts installed by FiberSteel."
>
  <PageHero
    title="Warranty"
    titleHtml="The FiberSteel <em>warranty</em>"
    eyebrow="Owners"
    lead="A lifetime warranty on the polyethylene tanks and the lift frame, for as long as the original purchaser owns the lift."
    crumbs={[{ label: 'Owners', href: withBase('/owners/') }, { label: 'Warranty' }]}
    image={hero}
  >
    <a href={withBase('/warranty/register/')} class="btn btn--sun"><Icon name="clipboard" size={18} /> Register your lift</a>
    <a href={withBase('/service/')} class="btn btn--ghost-light">Request service</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="In plain words" title="What’s covered, <em>and for how long</em>" />
      <div class="coverage">
        {
          coverage.map((c) => (
            <div class="coverage__item">
              <p class="coverage__term">{c.term}</p>
              <p class="coverage__part">{c.part}</p>
              <p class="coverage__detail">{c.detail}</p>
            </div>
          ))
        }
      </div>
      <ul class="checklist key-points">
        {
          keyPoints.map((k) => (
            <li>
              <Icon name="info" size={18} /> <span>{k}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container container--narrow">
      <h2>The full warranty</h2>
      <p class="muted">As FiberSteel’s <a class="text-link" href={sources.warranty.url} target="_blank" rel="noopener">current warranty page</a> states it.</p>
      <div class="terms">
        {terms.map((t) => <p>{t}</p>)}
      </div>

      <h3 class="mt-7">Remote control systems</h3>
      <ul class="remote-w" role="list">
        {
          remoteWarranty.map((r) => (
            <li>
              <strong>{r.system}</strong>
              <span>{r.note}</span>
              <span>
                {r.who} — <a href={tel(r.phone)}>{prettyPhone(r.phone)}</a>
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-7">Cancellations</h3>
      <p class="terms__cancel">{cancellation}</p>
    </div>
  </section>

  <CtaBand
    title="Register your lift, <em>keep the proof on file</em>"
    text={`The warranty starts with proof of original ownership. Register online, or call ${prettyPhone(site.sales.phone)}.`}
    quoteHref={withBase('/warranty/register/')}
    image="parts/hull-protectors"
  />
</BaseLayout>

<style>
  .coverage {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }

  .coverage__item {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-top: 5px solid var(--c-accent);
  }

  .coverage__term {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 820;
    font-size: var(--fs-2xl);
    color: var(--c-ink);
    line-height: 1.1;
  }

  .coverage__part {
    font-weight: 700;
  }

  .coverage__detail {
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }

  .key-points {
    margin-top: var(--space-6);
  }

  .key-points li > :global(svg) {
    color: var(--c-accent);
  }

  .terms {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }

  .remote-w {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
  }

  .remote-w li {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }

  .remote-w a {
    color: var(--c-accent);
    font-weight: 600;
  }

  .terms__cancel {
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--c-text-muted);
  }
</style>
