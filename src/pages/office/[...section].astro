---
/**
 * FiberSteel mode — the optional staff demo that goes with the website concept. Purely a demo with sample data; a real
 * one would be customized to how FiberSteel works. Every section is pre-rendered as its own page so deep links work
 * on static hosting; the app itself is a client-only Preact island.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter/opsz.css';
import '../../office/styles/index.css';

import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import OfficeApp from '../../office/App';
import logo from '../../assets/brand/logo.png';
import { photo } from '../../data/photos';
import { installs } from '../../data/installs';
import { usedLifts } from '../../data/usedLifts';
import { withBase } from '../../scripts/url';

export function getStaticPaths() {
  return [undefined, 'my-day', 'inbox', 'jobs', 'customers', 'warranty', 'inventory', 'dealers', 'accounting', 'analytics', 'website', 'settings'].map((section) => ({
    params: { section },
  }));
}

const src = async (image: ImageMetadata, width: number) => (await getImage({ src: image, width, format: 'webp' })).src;

// Thumbnails for catalog items and lifts — FiberSteel's own photos (src/data/photos.ts). Other makers' products
// (remote systems, docking stations) get an icon instead of their marketing photos.
const thumbs: Record<string, string> = {
  'boat-lift': 'vbottom/10000-lift',
  pontoon: 'pontoon/tritoon-lift',
  pwc: 'pwc/single-pwc',
  'pwc-twin': 'pwc/twin-set',
  shallow: 'shallow/8000-shallow-v-bunks',
  front: 'front/6800-front-mounted',
  large: 'large/24000-back-in',
  bunks: 'parts/bunk-brackets-v-bunks',
  hardware: 'parts/bushing-assembly',
  controls: 'parts/tank-shut-off-valve',
  guides: 'parts/lift-guides',
  'pwc-bracket': 'parts/pwc-dock-bracket',
  'front-bracket': 'parts/front-mount-bracket',
  vbrace: 'parts/v-brace',
  hull: 'parts/hull-protectors',
  steps: 'docksteps/raised',
  used: 'vbottom/8000-lift',
};

// Website section: the sample installs' and sample used listings' lead photos, card-sized (keys install:<slug>, used:<id>)
const cards: Record<string, string> = Object.fromEntries([
  ...installs.map((i) => [`install:${i.slug}`, i.photos[0]]),
  ...usedLifts.map((u) => [`used:${u.id}`, u.photo]),
]);

const assets = {
  logo: await src(logo, 264),
  mark: withBase('/favicon.svg'),
  signin: await src(photo('performance/14000-back-in-walkboards').src, 1200),
  avatars: {},
  photos: Object.fromEntries([
    ...(await Promise.all(Object.entries(thumbs).map(async ([key, id]) => [key, await src(photo(id).src, 120)]))),
    ...(await Promise.all(Object.entries(cards).map(async ([key, id]) => [key, await src(photo(id).src, 480)]))),
  ]),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b2545" />
    <meta name="format-detection" content="telephone=no" />
    <title>FiberSteel mode (demo)</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Navigating again mid-transition rejects the page transition's promises — nothing to report.
      ['pageswap', 'pagereveal'].forEach((type) =>
        addEventListener(type, (e) => {
          const vt = e.viewTransition;
          if (vt) [vt.ready, vt.finished, vt.updateCallbackDone].forEach((p) => p && p.catch(() => {}));
        }),
      );
    </script>
  </head>
  <body>
    <OfficeApp client:only="preact" assets={assets}>
      <div slot="fallback" class="boot" role="status"><span class="spinner" aria-hidden="true"></span> Loading FiberSteel mode (a demo)…</div>
    </OfficeApp>
    <noscript><p class="boot">FiberSteel mode is an interactive demo with sample data and needs JavaScript.</p></noscript>
  </body>
</html>
